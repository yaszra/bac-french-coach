{
  "name": "athar",
  "private": true,
  "version": "0.1.0",
  "description": "ATHAR — Qur'an Memory System. Memory made visible.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:db && npm run build && npm run budget",
    "test:pg": "vitest run tests/pg-integration.test.ts",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "budget": "node scripts/bundle-budget.mjs",
    "drill": "bash scripts/restore-drill.sh"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
