# Runtime connection — the application role. RLS applies to it (FORCE ROW LEVEL
# SECURITY), so a missing tenant context yields zero rows, never another org's.
DATABASE_URL=postgresql://itqan:itqan@localhost:5432/itqan
# Migration connection — the owning role. Used by `prisma migrate` only.
DIRECT_DATABASE_URL=postgresql://itqan:itqan@localhost:5432/itqan
SESSION_SECRET=dev-only-secret-0123456789abcdef0123456789abcdef
LOG_LEVEL=info
