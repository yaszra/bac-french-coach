{
  // The end-to-end specs are TypeScript that the app's own tsconfig excludes —
  // so until this existed, nothing typechecked them, and a spec referring to a
  // fixture it had not destructured was found only by running it. They are
  // checked here, against the same strict settings, with the Playwright and
  // Node types they actually use.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
