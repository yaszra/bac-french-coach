# Itqān environment — copy to .env and fill in. Secrets never in the image.
DATABASE_URL=postgresql://itqan:itqan@localhost:5432/itqan
# Session signing (HMAC-SHA256). Rotate via SESSION_SECRET_PREVIOUS during rollover.
SESSION_SECRET=change-me-64-bytes-hex
SESSION_SECRET_PREVIOUS=
# Object storage (S3-compatible) for audio, models and offline packs
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=itqan-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=
CDN_BASE_URL=
# Observability
SENTRY_DSN=
LOG_LEVEL=info
